  "caveat": "Structural markers are not a complete semantic security proof. Existing verified call paths remain unchanged.",
  "missingContracts": [
    {
      "id": "owner_audience",
      "scope": "All stored briefs and saved brief copies",
      "required": "Restrictive active-owner workspace boundary covering create/load/reuse/complete/copy and historical artifacts; preserve current trusted terminal triggers and actor/session checks. No creator-only subsystem or seats."
    },
    {
      "id": "source_binding",
      "scope": "Additional connector histories/snapshots and protected QBO/Square source dependencies",
      "required": "Reviewed versioned source-reference contract accepting provider+connection+composite record identity, resolving authoritative source/version and revocation. Do not merely add composite-ID tables to UUID-only Sheets allowlist. Preserve Sheets actor-bound ticket; new evidence must not be mislabeled as Sheets."
    },
    {
      "id": "entity_correspondence",
      "scope": "Loyverse, Zoho Books, Wix, Xero, Harvest, Clockify, Toggl, Zoho Inventory, Katana",
      "required": "Canonical workspace business-entity mapping absent from connection identity metadata. Proposed separate owner-confirmed mapping keyed by workspace/provider/connection plus source scope. No matching by labels or assuming one entity per workspace. Exact persistence design requires review; no automatic backfill."
    },
    {
      "id": "stable_citations",
      "scope": "Mutable reporting snapshots, aggregate history RPCs, composite record stores",
      "required": "Retain source identity and version/content hash, dates, coverage and all contributing records; verify on reopen and distinguish changed/unavailable source. Review whether current immutable source infrastructure can hold references without copying raw customer data. Aggregate-only response is not immutable record lineage."
    },
    {
      "id": "read_path",
      "scope": "Loyverse and Zoho Books aggregation",
      "required": "Existing aggregate RPCs are service-role-only without actor/session args. Do not add service role reasoning path. Prefer authenticated RLS reads if completeness can be established, or narrowly scoped owner/session invoker reader proposal; preserve original revokes."
    }
  ],
  "status": "Local draft adapters only; runtime wiring blocked pending these reviewed contracts. No schema or security changes applied."
