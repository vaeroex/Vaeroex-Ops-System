NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Public Cloudflare Turnstile site key. Configure only where Supabase CAPTCHA is enabled.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
OPENAI_API_KEY=
OPENAI_MODEL=
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
# OpenAI remains active unless this is explicitly changed to nvidia.
AI_PROVIDER=openai
NVIDIA_API_KEY=
# Optional server-only NeMo Retriever shadow POC controls. All gates must be explicit.
NVIDIA_RERANK_API_KEY=
NVIDIA_RERANK_BASE_URL=
NVIDIA_RERANK_INPUT_COST_CENTS_PER_1M=
VAEROEX_NVIDIA_RERANK_POC=false
VAEROEX_NVIDIA_RERANK_SHADOW=false
VAEROEX_EVIDENCE_ENGINE_SHADOW_CONFIRM=
VAEROEX_NVIDIA_RERANK_BENCHMARK_MODE=
# Content-free candidate-pool measurements; hard-disabled in Production.
VAEROEX_RERANK_POOL_INSTRUMENTATION=false
# Business Health Executive Synthesis selector. Sol is primary and Terra is the single fallback.
VAEROEX_EXECUTIVE_SYNTHESIS_POLICY=
# Weekly/Monthly Intelligence Briefing selector. Sol is primary and Terra is the single fallback.
VAEROEX_INTELLIGENCE_BRIEFING_POLICY=
# Dedicated Business Notes extraction selector. Luna is primary and Terra is the single fallback.
VAEROEX_BUSINESS_NOTES_POLICY=
# Optional path-specific model overrides. Leave blank until benchmark results justify a change.
VAEROEX_FOCUSED_EXPLANATION_MODEL=
VAEROEX_CROSS_BUSINESS_MODEL=
VAEROEX_FILE_ANALYSIS_MODEL=
# Optional evidence retrieval/cost controls.
VAEROEX_MAX_EVIDENCE_CHUNKS=8
OPENAI_INPUT_COST_CENTS_PER_1M=
OPENAI_OUTPUT_COST_CENTS_PER_1M=
NVIDIA_INPUT_COST_CENTS_PER_1M=
NVIDIA_OUTPUT_COST_CENTS_PER_1M=
# Optional provider safeguards. Defaults are production-safe when left blank.
VAEROEX_AI_RATE_LIMIT_WINDOW_SECONDS=600
VAEROEX_AI_USER_RATE_LIMIT=60
VAEROEX_AI_WORKSPACE_RATE_LIMIT=240
VAEROEX_WORKSPACE_MONTHLY_TOKEN_BUDGET=2000000
VAEROEX_SINGLE_REQUEST_TOKEN_BUDGET=120000
VAEROEX_OPENAI_TIMEOUT_MS=18000
VAEROEX_NVIDIA_TIMEOUT_MS=18000
# Admin-only provider smoke endpoint remains disabled unless explicitly enabled.
VAEROEX_AI_SMOKE_TEST_ENABLED=false
# Scheduler bearer secret, at least 32 characters; shared by Sheets refresh and
# /api/storage-capacity/maintenance (every 15 minutes in vercel.json).
CRON_SECRET=
RESEND_API_KEY=
# Optional. Defaults to Vaeroex <hq@vaeroex.com>.
RESEND_FROM_EMAIL=
NEXT_PUBLIC_APP_URL=
# Google Sheets connector is dormant until every server-side value is set and
# this flag is explicitly true. Never prefix these secrets with NEXT_PUBLIC_.
GOOGLE_SHEETS_ENABLED=false
GOOGLE_SHEETS_CLIENT_ID=
GOOGLE_SHEETS_CLIENT_SECRET=
GOOGLE_SHEETS_REDIRECT_URI=https://www.vaeroex.com/api/integrations/google-sheets/callback
# Base64 of exactly 32 random bytes, for example: openssl rand -base64 32
GOOGLE_SHEETS_TOKEN_ENCRYPTION_KEY=
# Zoho Books server-based OAuth app. The client can serve U.S. organizations immediately.
ZOHO_BOOKS_ENABLED=false
ZOHO_BOOKS_CLIENT_ID=
ZOHO_BOOKS_CLIENT_SECRET=
ZOHO_BOOKS_REDIRECT_URI=https://www.vaeroex.com/api/integrations/zoho-books/callback
# Generate 32 random bytes and encode them as standard base64.
ZOHO_BOOKS_TOKEN_ENCRYPTION_KEY=
LOYVERSE_ENABLED=false
LOYVERSE_CLIENT_ID=
LOYVERSE_CLIENT_SECRET=
LOYVERSE_REDIRECT_URI=https://www.vaeroex.com/api/integrations/loyverse/callback
# Generate 32 random bytes and encode them as standard base64.
LOYVERSE_TOKEN_ENCRYPTION_KEY=
# BambooHR registered OAuth app. Keep off until callback, scopes, and credentials are verified.
BAMBOOHR_ENABLED=false
BAMBOOHR_CLIENT_ID=
BAMBOOHR_CLIENT_SECRET=
BAMBOOHR_REDIRECT_URI=https://www.vaeroex.com/api/integrations/bamboohr/callback
# Generate 32 random bytes and encode them as standard base64.
BAMBOOHR_TOKEN_ENCRYPTION_KEY=
VAEROEX_ADMIN_EMAILS=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_OPERATIONS_INTELLIGENCE_MONTHLY=
# Workspace-specific capacity: $5 USD monthly per 10 GB / 500 file slots.
STRIPE_PRICE_WORKSPACE_CAPACITY_MONTHLY=
STRIPE_PUBLISHABLE_KEY=
# Leave empty until the owner approves the final live terms. Test mode does not
# require this gate. Approved value: storage-capacity-v1.
WORKSPACE_CAPACITY_PURCHASES_APPROVED_TERMS=

# Legacy Squarespace support only. Not required for new Stripe checkout.
SQUARESPACE_API_KEY=
SQUARESPACE_WEBHOOK_SECRET=
SQUARESPACE_VAEROEX_PRODUCT_ID=
SQUARESPACE_VAEROEX_SKU=
NEXT_PUBLIC_SQUARESPACE_VAEROEX_CHECKOUT_URL=

# VSI uses only gpt-6-luna. Ordinary requests use OPENAI_API_KEY;
# requests with verified Google-derived context require the dedicated key below.
# Separate monthly workspace spend safeguard in USD; 100 questions/person/rolling 24h is a ceiling.
VAEROEX_VSI_WORKSPACE_MONTHLY_BUDGET_USD=50
VAEROEX_VSI_TIMEOUT_MS=180000
VAEROEX_VSI_MAX_INPUT_CHARS=48000
VAEROEX_VSI_MAX_OUTPUT_TOKENS=6000
VAEROEX_VSI_MAX_RESEARCH_OUTPUT_TOKENS=8000
VAEROEX_VSI_MAX_WEB_SEARCH_CALLS=12
VAEROEX_VSI_REQUEST_RESERVE_USD=0.25

# Dedicated server-only credential for Google-derived requests. Preserve the existing
# OPENAI_API_KEY and its Production/Preview targets. Verify the dedicated issuing
# project and its data controls; Google-derived analysis fails closed without all three.
GOOGLE_SHEETS_OPENAI_API_KEY=
# These two pins are project identifiers, not credentials or a ZDR attestation.
GOOGLE_SHEETS_OPENAI_ORGANIZATION_ID=
GOOGLE_SHEETS_OPENAI_PROJECT_ID=

# During Google verification, limit connector use to authorized pilot workspaces.
# Comma-separated UUIDs; unset preserves availability, invalid/empty denies use.
# Server only. Never put workspace identifiers in NEXT_PUBLIC variables.
# GOOGLE_SHEETS_ALLOWED_WORKSPACE_IDS=
