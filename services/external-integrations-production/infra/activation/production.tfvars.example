# Reviewed second-stage release pins. The first-stage infrastructure apply used
# null for both values and created no Cloud Run or load-balancer runtime path.
# Change any digest or the callback source commit only after rebuilding from
# reviewed source, scanning the exact digest, and updating the release-pin
# regressions in the same review. A callback-only release changes the OAuth
# callback and edge inputs, leaving bootstrap_image_digest unchanged.
bootstrap_image_digest = "us-west1-docker.pkg.dev/vaeroex-integrations-prod/vaeroex-integrations-images/production-bootstrap@sha256:d56fe933eab1322bb4fe905b183964a980d641af23d69904e15989add501dc6f"
oauth_callback_image_digest = "us-west1-docker.pkg.dev/vaeroex-integrations-prod/vaeroex-integrations-images/production-bootstrap@sha256:ebd5e50ab854ca3de3f49ee51ea8fbef0dfa5510b74c19b0ec6e9c367fffeddf"
