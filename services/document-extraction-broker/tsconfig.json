{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "baseUrl": ".",
    "paths": {
      "@/*": ["../../*"]
    }
  },
  "include": [
    "src/**/*.ts",
    "../../lib/document-extraction/**/*.ts",
    "../../lib/supabase/admin.ts",
    "../../lib/supabase/types.ts"
  ]
}
